<?xml version="1.0" encoding="utf-8"?><!--
  弹出面板（§7.1 排布，全部自绘）：
  标题行(含收起 / 设置齿轮) → 常用程序宫格(Phase 1) → 三大金刚行(Phase 2)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="@dimen/panel_padding">

    <!-- ===== 顶部：标题 + 设置齿轮（§7.1） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_panel_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_on_panel"
            android:textSize="@dimen/panel_title_text"
            android:textStyle="bold"
            tools:text="车机悬浮球·迷你版"
            xmlns:tools="http://schemas.android.com/tools" />

        <!-- 收起面板（标题行入口）：仅关闭当前悬浮窗口（面板），悬浮球与前台服务保持不动 -->
        <ImageButton
            android:id="@+id/btn_panel_close"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_nav_key"
            android:contentDescription="@string/btn_close_panel"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:src="@drawable/ic_close_panel" />

        <ImageButton
            android:id="@+id/btn_panel_settings"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_nav_key"
            android:contentDescription="@string/title_settings"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/panel_divider" />

    <!-- 应用区左右滑动，标题和底部导航固定。 -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/apps_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:id="@+id/panel_page_dots"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center"
        android:importantForAccessibility="yes"
        android:orientation="horizontal"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/panel_divider" />

    <!-- 底部导航键等宽铺开，实际高度由 PanelController 设置。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_nav_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_key"
            android:contentDescription="@string/nav_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_back" />

        <ImageButton
            android:id="@+id/btn_nav_home"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_nav_key"
            android:contentDescription="@string/nav_home"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_home" />

        <ImageButton
            android:id="@+id/btn_nav_recents"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_key"
            android:contentDescription="@string/nav_recents"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_recents" />
    </LinearLayout>
</LinearLayout>
